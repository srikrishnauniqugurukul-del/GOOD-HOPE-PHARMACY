# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# Supabase PostgreSQL Configuration (Optional — when provided, backend connects directly to Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin Security Passcode (Optional — if left blank, use the one-time First-Run Admin Setup form at /admin/login)
ADMIN_PASSCODE=

# Session signing secret (Optional — falls back to secure random runtime secret if omitted)
SESSION_SECRET=
